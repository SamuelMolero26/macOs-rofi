/*
 * Derived from upstream rofi themes/material.rasi by Tomas Zaluckij and Dave Davenport.
 * Pinned reference: rofi commit 1ad1df6b72d4c8b0e40e8ced1249ef8a8a6bc0ad.
 * Based on Base16 Material; reduced under rofi's MIT license for parser compatibility.
 */
* {
    base03: #546E7A;
    base07: #FFFFFF;
    base0D: #82AAFF;
    background-color: transparent;
}
window {
    transparency: "real";
    background-color: #263238CC;
}
mainbox {
    children: [inputbar, message, mode-switcher, listview];
    padding: 30px 0;
    border: 1px;
    border-color: @base0D;
}
prompt { text-color: @base0D; }
entry { text-color: @base07; }
element normal normal, element selected normal { text-color: @base07; }
