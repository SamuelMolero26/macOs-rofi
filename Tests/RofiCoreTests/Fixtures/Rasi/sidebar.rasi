* {
    text-color: #ffeedd;
    background-color: rgba(0, 0, 0, 0);
    blue: #6495ed;
}
window {
    height: 100%;
    width: 30em;
    location: west;
    border: 0px 2px 0px 0px;
}
listview { dynamic: false; lines: 0; }
element selected normal { background-color: @blue; }
